% Generated by tools/build.py from content/*.yaml and templates/cv/cv.tex.j2 -- do not edit by hand.
% Layout and macros live in cv/templates/cv-template.tex
<% if babel %>
\newcommand{\cvbabel}{<< babel >>}
<% endif %>
\input{../templates/cv-template.tex}
\renewcommand{\cvpagelabel}{<< t.cv.page_label|x >>}

\begin{document}

% =====================================================================
% PAGE 1
% =====================================================================
\noindent
\begin{minipage}[t]{\sidebarw}\vspace{0pt}
  \begin{center}{\color{accent}\fontsize{18}{20}\selectfont << d.person_name|x >>}\\[1mm]
  {\footnotesize\color{subgray}<< t.cv.location|x >>}\end{center}

  \sidesection{<< t.cv.sections.contact|x >>}
  {\footnotesize
  \faEnvelope\hspace{1.6mm}\href{mailto:<< d.site.email >>}{<< d.site.email >>}\\[1mm]
  \faLinkedin\hspace{1.6mm}\href{<< d.site.linkedin_url|xurl >>}{<< d.site.linkedin_label|x >>}\\[1mm]
  \faGithub\hspace{1.9mm}\href{<< d.site.github_url|xurl >>}{<< d.site.github_label|x >>}\\[0.4mm]
  {\scriptsize\color{subgray}\RaggedRight\textit{<< t.cv.github_note|x >>}\par}\vspace{1mm}
  \faGlobe\hspace{1.6mm}\href{<< d.site.base_url >><< 'de/' if lang == 'de' else '' >>}{<< d.site.site_label|x >>}\par}

  \sidesection{<< t.cv.sections.languages|x >>}
<% for l in d.languages %>
  \lang{<< t.cv.languages[l.id].name|x >>}{<< t.cv.languages[l.id].level|x >>}{<< l.dots >>}
<% endfor %>

  \sidesection{<< t.cv.sections.competencies|x >>}
  \begin{cvitems}
<% for c in t.cv.competencies %>
    \item << c|x >>
<% endfor %>
  \end{cvitems}
\end{minipage}%
\hspace{\cvgap}%
\begin{minipage}[t]{\mainw}\vspace{0pt}\RaggedRight
  {\color{accent}\fontsize{18}{21}\selectfont << t.hero.h1|x|upper >>}\\[1.2mm]
  {\color{subgray}\fontsize{11}{13}\selectfont << t.cv.subtitle|x >>}
  \par\vspace{0.6mm}{\color{accent}\rule{\linewidth}{1.1pt}}

  \vspace{1.6mm}
  {\color{accent}\fontsize{11}{13}\selectfont\bfseries << t.cv.sections.profile|x >>}\par\vspace{0.8mm}
  << t.cv.profile|x >>\par

  \mainsection{<< t.cv.sections.highlights|x >>}
  \begin{cvhl}
<% for h in t.cv.highlights %>
    \item << h|x >>
<% endfor %>
  \end{cvhl}

  \mainsection{<< t.cv.sections.positions|x >>}
<% for r in d.roles %>
  \cvevent{<< r.start >> -- << (r.end or t.common.today)|x >>}{<< t.common.roles[r.id].title|x >> \textbar\ << t.common.employer|x >>}{<< t.cv.roles[r.id].unit|x >>}{%
    \begin{cvitems}
<% for b in t.cv.roles[r.id].bullets %>
      \item << b|x >>
<% endfor %>
    \end{cvitems}}
<% endfor %>
\end{minipage}

\newpage

% =====================================================================
% PAGE 2
% =====================================================================
\noindent
\begin{minipage}[t]{\sidebarw}\vspace{0pt}
  \sidesection{<< t.cv.sections.tools|x >>}
<% for g in d.cv_tools %>
  \toolgroup{<< t.cv.tool_groups[g.id]|x >>}{<< g.tools|x >>}
<% endfor %>

  \sidesection{<< t.cv.sections.qualifications|x >>}
  \begin{cvitems}
<% for q in t.cv.qualifications %>
    \item << q|x >>
<% endfor %>
  \end{cvitems}

  \sidesection{<< t.cv.sections.interests|x >>}
  \begin{cvitems}
<% for i in t.cv.interests %>
    \item << i|x >>
<% endfor %>
  \end{cvitems}
\end{minipage}%
\hspace{\cvgap}%
\begin{minipage}[t]{\mainw}\vspace{0pt}\RaggedRight
  \mainsection{<< t.cv.sections.case|x >>}
  \cvevent{<< d.case.start >> -- << (d.case.end or t.common.today)|x >>}{<< t.cv.case.title|x >>}{<< t.cv.case.unit|x >>}{%
    \begin{cvitems}
<% for b in t.cv.case.bullets %>
      \item << b|x >>
<% endfor %>
    \end{cvitems}}

  \mainsection{<< t.cv.sections.patents|x >>}
<% for p in d.patents %>
  \patent{<< p.id >>}{<< t.common.patents[p.id]|x >>.\\{\footnotesize\color{subgray}<< (t.cv.patent_sole if p.inventor == 'sole' else t.cv.patent_co)|x >> \textbullet\ << t.cv.patent_published.format(date=p.published)|x >> \textbullet\ << t.cv.patent_filed.format(where=p.filed)|x >><< (t.cv.patent_granted|x) if p.granted else '' >>}}{<< espacenet(p.id)|xurl >>}
<% endfor %>

  \mainsection{<< t.cv.sections.education|x >>}
<% for e in d.education %>
  \cvevent{<< e.start >> -- << e.end >>}{<< t.common.education[e.id].title|x >>}{\href{<< e.url|xurl >>}{<< t.common.education[e.id].org|x >>}}{%
    \begin{cvitems}
<% for b in t.cv.education[e.id] %>
      \item << b|x >>
<% endfor %>
    \end{cvitems}}
<% endfor %>
\end{minipage}

\end{document}
